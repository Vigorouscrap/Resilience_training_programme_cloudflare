NODE_ENV=development
HOST=127.0.0.1
PORT=8787

AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=15000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resilience_programme
SESSION_SECRET=replace-me
CORS_ORIGIN=http://localhost:8000
# 多个来源可用英文逗号分隔，例如：
# CORS_ORIGIN=http://localhost:8000,https://your-vercel-site.vercel.app,https://your-cn-frontend.example.com

TESTER_PARTICIPANT_CODES=C_TEST
ADMIN_PARTICIPANT_CODES=
# Empty token disables export. Generate different tokens for the two deployments.
ADMIN_EXPORT_TOKEN=
EXPORT_CREDENTIAL_ID=mainland-primary
# Optional migration-only connection (schema owner); keep it out of service env.
# MIGRATION_DATABASE_URL=postgresql://resilience_owner:replace-me@127.0.0.1:5432/resilience_programme
