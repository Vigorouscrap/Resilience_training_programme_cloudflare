{
  "name": "resilience-programme-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-prompt-assets.mjs",
    "smoke:health": "node scripts/smoke-health.mjs",
    "verify:prod": "npm run build && npm run smoke:health",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.15.5",
    "@electric-sql/pglite": "^0.3.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
