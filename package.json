{
  "name": "resilience-programme",
  "version": "1.0.0",
  "description": "心理弹性训练 - 基于正念和接纳承诺疗法的个人成长计划",
  "main": "src/js/main.js",
  "type": "module",
  "scripts": {
    "start": "python -m http.server 8000 --bind 0.0.0.0 --directory src",
    "dev": "python -m http.server 8000 --bind 0.0.0.0 --directory src",
    "start:local": "python -m http.server 8000 --bind 127.0.0.1 --directory src",
    "build": "npm run build:cloudflare",
    "build:cloudflare": "node scripts/prepare-runtime-config.mjs cloudflare",
    "build:mainland": "node scripts/prepare-runtime-config.mjs mainland",
    "verify:mainland": "node scripts/verify-mainland-deployment.mjs",
    "smoke:mainland:browser": "node scripts/smoke-mainland-browser.mjs",
    "smoke:mainland:modules": "node scripts/smoke-mainland-modules.mjs",
    "smoke:mainland:deep": "node scripts/smoke-mainland-deep.mjs",
    "smoke:mainland:recovery": "node scripts/smoke-mainland-recovery.mjs",
    "test:contract:unit": "node --test shared-contract/*.test.mjs",
    "test:contract:fastify-local": "npm --prefix backend run build && node scripts/contract-test-fastify-local.mjs",
    "test:contract": "node scripts/contract-test.mjs",
    "test:research": "npm --prefix backend run build && node backend/scripts/research-test.mjs"
  },
  "keywords": [
    "心理弹性",
    "正念练习",
    "心理健康",
    "个人成长"
  ],
  "author": "香港大学研究团队",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/resilience-programme.git"
  }
}
